          { "name": "危害水生环境长期危害类别", "type": "string", "description": "来自 GSDS PDF（GHS）", "required": false },
          { "name": "海洋污染物", "type": "string", "description": "来自 GSDS PDF", "required": false },
          { "name": "急毒性", "type": "string", "description": "来自 GSDS PDF", "required": false },
