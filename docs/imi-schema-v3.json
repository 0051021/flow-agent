  "nodes": [
    {
      "id": "node-1",
      "identity": {
        "label": "解析 Leader 邮件并写入大表基础列",
        "icon": "Mail",
        "description": "从 Outlook 收到的 Leader 邮件正文中解析一条或多条申请（适用目的港、IMI证书编号、BBN、PART、中英文名称、运输方式、物料号）；为每条生成或更新 IMI 申请大表行，申请编号为当前最大编号+1（累加）。",
        "stepIndex": 1,
        "totalSteps": 9,
        "executionMode": "human_confirm",
        "estimatedTime": "10-20 分钟"
      },
      "dataContract": {
        "inputs": [
          {
            "id": "in-1-1",
            "name": "Leader 申请邮件",
            "docRef": "doc-leader-email",
            "source": "user",
            "required": true,
            "kind": "document",
            "sourceType": "inline",
            "mediaType": "message/rfc822"
          },
          {
            "id": "in-1-2",
            "name": "IMI 申请大表（当前版本）",
            "docRef": "doc-imi-master",
            "source": "default",
            "required": true,
            "kind": "document",
            "sourceType": "file_path",
            "mediaType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
          }
        ],
        "outputs": [
          {
            "id": "out-1-1",
            "name": "已写入 Leader 字段的 IMI 申请大表",
            "docRef": "doc-imi-master",
            "kind": "document",
            "intent": "含自增申请编号及 Leader 各列的新增/更新行",
            "mutations": ["追加或更新行", "申请编号累加"],
            "flowsTo": ["node-2"]
          }
        ]
      },
      "businessIntent": [
        {
          "stepIndex": 1,
          "type": "parse",
          "description": "解析邮件正文，提取多条或单条申请的字段",
          "target": { "docRef": "doc-leader-email" },
          "keyFields": ["BBN", "PART", "适用目的港", "运输方式"]
        },
        {
          "stepIndex": 2,
          "type": "transform",
          "description": "计算申请编号：max(现有申请编号)+1 逐条分配",
          "target": { "docRef": "doc-imi-master" }
        },
        {
          "stepIndex": 3,
          "type": "write",
          "description": "将 Leader 字段写入 IMI 申请大表对应列",
          "target": { "docRef": "doc-imi-master" }
        },
        {
          "stepIndex": 4,
          "type": "validate",
          "description": "校验 BBN、PART、运输方式等必填项",
          "onError": "human_fallback"
        }
      ],
      "taskType": "agentic",
      "humanInteraction": {
        "type": "verify",
        "description": "确认解析出的申请行与申请编号是否正确",
        "reviewLayout": "card",
        "checkItems": ["BBN/PART 是否与邮件一致", "运输方式是否正确", "申请编号是否连续正确"],
        "timeout": { "value": 24, "unit": "hours" },
        "timeoutAction": "pause_and_notify"
      },
      "qualityHint": {
        "onFailure": { "strategy": "human_fallback", "notifyRoles": ["business"] }
      },
      "errorStrategy": {
        "strategy": "human_fallback",
        "timeout": { "totalSeconds": 3600, "onExternalTimeout": "fail" },
        "notifyRoles": ["business"],
        "fallbackDescription": "解析失败时由用户手工录入大表"
      },
      "edges": [
        {
          "targetNodeId": "node-2",
          "dataFlow": [
            { "sourceOutput": "out-1-1", "targetInput": "in-2-1", "description": "大表传递给 GSDS 补全" }
          ]
        }
      ]
    },
    {
      "id": "node-2",
      "identity": {
        "label": "按 BBN+PART 定位 GSDS 并补全大表",
        "icon": "FileSearch",
        "description": "在共享盘按 BBN → BBN_PART 目录查找该组合下最新版本 GSDS PDF；抽取图中列及成分｜含量｜CAS、密度；将密度保留两位小数写入 SDS密度列；其余字段写入 IMI 申请大表。",
        "stepIndex": 2,
        "totalSteps": 9,
        "executionMode": "ai_auto",
        "estimatedTime": "5-15 分钟"
      },
      "dataContract": {
        "inputs": [
          {
            "id": "in-2-1",
            "name": "IMI 申请大表（含 Leader 列）",
            "docRef": "doc-imi-master",
            "source": "previous_step",
            "sourceNodeId": "node-1",
            "required": true,
            "kind": "document",
            "sourceType": "file_path",
            "mediaType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
          },
          {
            "id": "in-2-2",
            "name": "GSDS PDF（按行解析路径）",
            "docRef": "doc-gsds-pdf",
            "source": "external_system",
            "required": true,
            "kind": "document",
            "sourceType": "file_path",
            "mediaType": "application/pdf"
          }
        ],
        "outputs": [
          {
            "id": "out-2-1",
            "name": "GSDS 已补全的 IMI 申请大表",
            "docRef": "doc-imi-master",
            "kind": "document",
            "intent": "已写入 GSDS 各列及 SDS密度",
            "mutations": ["写入颜色状态运输UN危类包装GHS列等", "写入成分含量CAS", "SDS密度=round(密度,2)"],
            "flowsTo": ["node-3"]
          }
        ]
      },
      "businessIntent": [
        {
          "stepIndex": 1,
          "type": "query",
          "description": "按每行 BBN+PART 解析共享盘路径并选取最新版本 GSDS PDF",
          "target": { "docRef": "doc-gsds-pdf" },
          "keyFields": ["BBN", "PART"]
        },
        {
          "stepIndex": 2,
          "type": "parse",
          "description": "从 PDF 抽取表格与文本中的安全数据字段及成分｜含量｜CAS",
          "target": { "docRef": "doc-gsds-pdf" }
        },
        {
          "stepIndex": 3,
          "type": "transform",
          "description": "将密度数值保留两位小数得到 SDS密度",
          "target": { "docRef": "doc-imi-master" }
        },
        {
          "stepIndex": 4,
          "type": "write",
          "description": "将抽取字段写入 IMI 申请大表对应列",
          "target": { "docRef": "doc-imi-master" }
        },
        {
          "stepIndex": 5,
          "type": "validate",
          "description": "检查每行是否找到 GSDS 且关键字段非空",
          "onError": "human_fallback"
        }
      ],
      "taskType": "agentic",
      "qualityHint": {
        "onFailure": { "strategy": "human_fallback", "notifyRoles": ["business", "tech"] }
      },
      "errorStrategy": {
        "strategy": "retry",
