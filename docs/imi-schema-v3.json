    "businessContext": "Leader邮件触发→IMI申请大表累加填写→按BBN+PART从共享盘取最新GSDS PDF补全→中外运网页上传→邮件海关→收证全字段核验→回填并归档IMI List（按海运/空运/陆运分sheet）。阶段1业务翻译骨架，binding字段待技术确认后回填。",
    "tags": ["IMI", "危险品", "GSDS", "海关", "中外运", "Outlook"]
  },
  "globalConfig": {
    "orchestration": {
      "type": "sequential"
    },
    "timezone": "Asia/Shanghai"
  },
  "documents": [
    {
      "id": "doc-leader-email",
      "name": "Leader申请邮件",
      "fileType": "email",
      "role": "external_input",
      "schema": {
        "type": "semi_structured",
        "knownFields": [
          { "name": "subject", "type": "string", "description": "邮件主题" },
          { "name": "from", "type": "string", "description": "发件人" }
        ],
        "extractionHints": [
          { "field": "适用目的港", "type": "string", "description": "正文中的适用目的港", "required": false },
          { "field": "IMI证书编号", "type": "string", "description": "正文中的IMI证书编号", "required": false },
          { "field": "BBN", "type": "string", "description": "产品编号", "required": true },
          { "field": "PART", "type": "string", "description": "零件号", "required": true },
          { "field": "中文名称", "type": "string", "description": "中文名称", "required": false },
          { "field": "英文名称", "type": "string", "description": "英文名称", "required": false },
          { "field": "运输方式", "type": "string", "description": "运输方式（海运/空运/陆运等）", "required": true },
          { "field": "物料号", "type": "string", "description": "物料号", "required": false }
        ],
        "formatDescription": "正文为文字列表；一封邮件可能含一条或多条申请记录，格式不固定"
      },
      "samples": [
        {
          "description": "单条申请示例",
          "data": {
            "subject": "IMI申请 - BBN-003 / Z-5590",
            "body": "目的港：Tokyo\nIMI证书编号：IMI-2025-001\nBBN：BBN-003\nPART：Z-5590\n中文名称：工业乙醇\n英文名称：Industrial Ethanol\n运输方式：海运\n物料号：MAT-88901"
          }
        }
      ],
      "constraints": ["使用 Outlook 收取；附件可能无，信息主要在正文"]
    },
