          { "name": "是否属于IMDGCode分类的危险货物", "type": "string", "description": "来自 IMI 证书", "required": false },
          { "name": "是否属于TDG分类的危险货物", "type": "string", "description": "来自 IMI 证书（原文可能截断，以证书为准）", "required": false }
        ]
      },
      "samples": [
